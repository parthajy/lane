{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lane",
  "version": "1.0.0",
  "identifier": "so.lane.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lane",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "overlay",
        "title": "Lane Recall",
        "url": "index.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "width": 720,
        "height": 520,
        "center": true,
        "focus": true
      },
      {
        "label": "notch",
        "title": "Lane Notch",
        "url": "index.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "width": 180,
        "height": 14,
        "x": 0,
        "y": 0,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Developer ID Application: Partha Borthakur (6AKUD88CVN)",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    },
    "resources": {
      "llama/": "llama/",
      "audio/lane-audio": "audio/lane-audio",
      "audio/lane-calendar": "audio/lane-calendar",
      "whisper/": "whisper/",
      "mcp/": "mcp/",
      "audio/lane-ocr": "audio/lane-ocr",
      "audio/lane-contacts": "audio/lane-contacts",
      "audio/lane-shot": "audio/lane-shot",
      "scripts/": "scripts/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2RUM1NUJCNTA5Mjg4QUMKUldTc2lKSlF1MVhzZGdpeTE0VWRyQWRxTnlBeFNoQzdJTlhNM2t5a09hLzJ6d1lOSkhBWmdRNjgK",
      "endpoints": [
        "https://lane.so/updates/{{target}}-{{arch}}.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "lane"
        ]
      }
    }
  }
}
