<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Lane is a menu-bar app: no Dock icon, and its floating windows may
         join other apps' full-screen Spaces (a Regular app's cannot). -->
    <key>LSUIElement</key>
    <true/>
    <!-- lane://licence/<key> so a receipt can unlock the app in one click. -->
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleURLName</key>
        <string>so.lane.app</string>
        <key>CFBundleTypeRole</key>
        <string>Viewer</string>
        <key>CFBundleURLSchemes</key>
        <array><string>lane</string></array>
      </dict>
    </array>
</dict>
</plist>
